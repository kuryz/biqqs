# =====================================================
# Channels - enable one or both. Each is independently
# optional; the app fails to start only if NEITHER is set.
# =====================================================

# --- Telegram ---
# 1. Open Telegram, message @BotFather
# 2. Send /newbot and follow the prompts (name, then a username ending in "bot")
# 3. BotFather gives you a token - paste it below
TELEGRAM_BOT_TOKEN=

# 'polling' works immediately with no public URL - best for local dev/testing.
# 'webhook' is better for production.
TELEGRAM_MODE=polling

# --- WhatsApp (Meta Cloud API) ---
# 1. Create a Meta App at developers.facebook.com > add the WhatsApp product
# 2. WHATSAPP_TOKEN: a permanent token from a System User (Business Settings),
#    or the temporary token shown in the App Dashboard for testing
# 3. WHATSAPP_PHONE_NUMBER_ID: from WhatsApp > API Setup in the App Dashboard
# 4. WHATSAPP_VERIFY_TOKEN: any string you make up - used once during webhook
#    registration to prove you control the callback URL
# 5. Register your webhook URL (https://your-domain/whatsapp/webhook) in
#    WhatsApp > Configuration in the App Dashboard, using the verify token above
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0

# Server
PORT=3000

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bookkeeper
MYSQL_PASSWORD=bookkeeper_pw
MYSQL_DATABASE=bookkeeper

# Redis cache (optional). If unset, the app falls back to a per-key JSON file
# cache automatically - fine for local dev/single-instance use, NOT for
# multi-instance production deployments (each instance would have its own
# file cache and could serve inconsistent numbers).
REDIS_URL=

# Seconds a business record stays cached before refetching from MySQL.
CACHE_TTL_SECONDS=60

# Billing / plan enforcement
# How many sales+expenses+new-credit-entries a free-plan business can log per
# calendar month before being asked to upgrade.
FREE_TIER_MONTHLY_LIMIT=30

# Shared secret for the in-chat admin upgrade command:
#   /admin_upgrade <chat_id> <ADMIN_TOKEN>
# Leave blank to disable the command entirely. This is a placeholder until
# real payment provider integration (Paystack/Flutterwave webhook) calls
# businessService.setPlan() directly - see README.
ADMIN_TOKEN=
